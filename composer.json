{
  "name": "inocean/tax-provider-us",
  "description": "This plugin implements different tax rates for USA, including multiple tax rates.",
  "version": "2.0.0",
  "type": "shopware-platform-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Inocean Technology (iecsp.com)",
      "email": "iecsp.com@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-zip": "*",
    "shopware/core": "~6.7.0 || ~6.8.0",
    "symfony/http-client": "^7.0 || ^8.0",
    "ext-dom": "*",
    "ext-mbstring": "*"
  },
  "extra": {
    "shopware-plugin-class": "InoceanTaxProviderUS\\InoceanTaxProviderUS",
    "plugin-icon": "src/Resources/config/plugin.png",
    "copyright": "(c) by Inocean Technology (iecsp.com)",
    "label": {
      "en-GB": "Inocean Tax Provider (US)",
      "en-US": "Inocean Tax Provider (US)",
      "de-DE": "Inocean Tax Provider (US)"
    }
  },
  "autoload": {
    "psr-4": {
      "InoceanTaxProviderUS\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "InoceanTaxProviderUS\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist"
  }
}
